{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "composite": true,
    "paths": {
      "@projectx/domain": ["./packages/domain/dist"],
      "@projectx/infrastructure": ["./packages/infrastructure/dist"],
      "@projectx/ai-runtime": ["./packages/ai-runtime/dist"],
      "@projectx/application": ["./packages/application/dist"],
      "@projectx/shared": ["./packages/shared/dist"],
      "@projectx/identity": ["./packages/identity/dist"],
      "@projectx/intelligence": ["./packages/intelligence/dist"],
      "@projectx/mission-orchestrator": ["./packages/mission-orchestrator/dist"],
      "@projectx/outreach": ["./packages/outreach/dist"],
      "@projectx/conversation": ["./packages/conversation/dist"],
      "@projectx/tool-gateway": ["./packages/tool-gateway/dist"],
      "@projectx/llm-gateway": ["./packages/llm-gateway/dist"],
      "@projectx/temporal-client": ["./packages/temporal-client/dist"],
      "@projectx/control-plane": ["./packages/control-plane/dist"],
      "@projectx/specialist-agents": ["./packages/specialist-agents/dist"]
    }
  },
  "exclude": ["node_modules", "dist", "*.d.ts"]
}
