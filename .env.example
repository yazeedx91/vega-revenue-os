# Example environment variables only.
# No production secrets, credentials, or real endpoints are committed.

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# Azure AD / Entra ID (use Managed Identity in Azure; client ID only where needed)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure OpenAI (endpoint only; key fetched from Key Vault)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

# PostgreSQL (connection string fetched from Key Vault in production)
DATABASE_URL=postgresql://user:password@localhost:5432/projectx

# Azure Managed Redis (hostname only; access key fetched from Key Vault)
REDIS_HOST=localhost
REDIS_PORT=6379

# Azure Service Bus (namespace only; connection via Managed Identity or Key Vault)
SERVICEBUS_NAMESPACE=

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=projectx
