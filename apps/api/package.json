{
  "name": "@projectx/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "test": "pnpm exec jest --config ../../jest.config.js --testPathPattern=\"apps/api\" --passWithNoTests",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@projectx/application": "workspace:*",
    "@projectx/conversation": "workspace:*",
    "@projectx/domain": "workspace:*",
    "@projectx/infrastructure": "workspace:*",
    "@projectx/mission-orchestrator": "workspace:*",
    "@projectx/outreach": "workspace:*",
    "@projectx/shared": "workspace:*",
    "@projectx/temporal-client": "workspace:*",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0"
  }
}
