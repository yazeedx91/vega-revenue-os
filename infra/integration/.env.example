# Integration test environment variables
# Copy this file to infra/integration/.env and adjust values as needed.
# NO PRODUCTION SECRETS OR CREDENTIALS.

NODE_ENV=development
LOG_LEVEL=debug

# Integration PostgreSQL (maps to localhost via docker-compose port forwarding)
DATABASE_URL=postgresql://projectx:projectx@localhost:5433/projectx

# Integration Redis
REDIS_URL=redis://localhost:6380

# Integration Temporal
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_NAMESPACE=default

# Azure / Entra (left empty; deterministic fake provider is used)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_KEY_VAULT_URL=

# Microsoft Graph (single dedicated test tenant for Phase 14.8a)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_CLIENT_SECRET_REFERENCE=
GRAPH_SENDER_ADDRESS=
GRAPH_WEBHOOK_CALLBACK_URL=

# Admin API key for integration tests (non-secret example value)
ADMIN_API_KEY=integration-admin-key

# Telemetry
TELEMETRY_MODE=console
OTEL_SERVICE_NAME=projectx-integration

# Safety: live email MUST remain false for Phase 14.7c
OUTREACH_LIVE_EMAIL_ENABLED=false
OUTREACH_MODE=ALLOWLIST_ONLY
