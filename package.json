{
  "name": "projectx",
  "version": "0.0.1",
  "private": true,
  "description": "AI-Native Autonomous Revenue Employee — TypeScript/NestJS monorepo foundation",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter api dev",
    "dev:ai-worker": "pnpm --filter ai-worker dev",
    "dev:bg-worker": "pnpm --filter background-worker dev",
    "dev:temporal-worker": "pnpm --filter temporal-worker dev",
    "e2e:up": "pwsh -ExecutionPolicy Bypass -File infra/scripts/integration-up.ps1",
    "e2e:down": "pwsh -ExecutionPolicy Bypass -File infra/scripts/integration-down.ps1",
    "e2e:reset": "pwsh -ExecutionPolicy Bypass -File infra/scripts/integration-reset.ps1",
    "e2e:wait": "pwsh -ExecutionPolicy Bypass -File infra/scripts/integration-wait.ps1",
    "test:e2e": "jest --config jest.e2e.config.js",
    "validate:workspace": "tsx scripts/validation/workspace-integrity.ts",
    "security:snyk-code": "node scripts/security/snyk-scan.js code",
    "security:snyk-deps": "node scripts/security/snyk-scan.js deps",
    "phase14:prepare-real-send": "tsx scripts/phase14-8-real-send/operator.ts prepare",
    "phase14:execute-real-send": "tsx scripts/phase14-8-real-send/operator.ts execute"
  },
  "devDependencies": {
    "@azure/msal-node": "^2.16.3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@projectx/conversation": "workspace:*",
    "@projectx/domain": "workspace:*",
    "@projectx/infrastructure": "workspace:*",
    "@projectx/mission-orchestrator": "workspace:*",
    "@projectx/outreach": "workspace:*",
    "@projectx/shared": "workspace:*",
    "@projectx/temporal-client": "workspace:*",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.30.0",
    "jest": "^29.7.0",
    "pg": "^8.12.0",
    "prettier": "^3.3.0",
    "redis": "^4.7.0",
    "snyk": "^1.1306.4",
    "ts-jest": "^29.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
