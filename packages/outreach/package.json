{
  "name": "@projectx/outreach",
  "version": "0.0.1",
  "private": true,
  "description": "Outreach Execution Kernel",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "pnpm exec jest --config ../../jest.config.js --testMatch='**/packages/outreach/**/*.spec.ts' --runInBand",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@projectx/ai-runtime": "workspace:*",
    "@projectx/domain": "workspace:*",
    "@projectx/infrastructure": "workspace:*",
    "@projectx/intelligence": "workspace:*",
    "@projectx/shared": "workspace:*",
    "pg": "^8.12.0",
    "sanitize-html": "2.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
